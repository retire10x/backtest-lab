---
export interface Props {
  title: string;
  description?: string;
  /** 기본은 간단 보기(숫자·표 위주). 자세히 보기는 설명 문단을 켠다. */
  bodyClass?: string;
}
const {
  title,
  description = '소액 개인 투자자를 위한, 검증 중심의 정직한 백테스트 정보 사이트.',
  bodyClass = 'mode-simple',
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · backtest-lab</title>
  </head>
  <body class={bodyClass}>
    <script is:inline>
      // 재방문 시 마지막 선택 복원. 저장된 값 없으면 서버가 준 mode-simple 유지.
      (function () {
        try {
          if (localStorage.getItem('bl-view-mode') === 'detail') {
            document.body.classList.remove('mode-simple');
            document.body.classList.add('mode-detail');
          }
        } catch (_) {}
      })();
    </script>
    <header class="site-header">
      <nav class="container">
        <a class="brand" href="/">backtest-lab</a>
        <div class="links">
          <a href="/#signal">이번 달엔 뭘?</a>
          <a href="/#history">최근 1년 흐름</a>
          <a href="/#backtest">그동안 성적은?</a>
        </div>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          backtest-lab은 무료로 제공되는 정보 사이트입니다. 1:1 투자 상담,
          맞춤형 투자 자문, 실시간 매매 추천을 제공하지 않습니다.
        </p>
        <p>© {new Date().getFullYear()} backtest-lab</p>
      </div>
    </footer>

    <style is:global>
      :root {
        color-scheme: light;
        --fg: #1a1a1a;
        --bg: #ffffff;
        --muted: #6b6b6b;
        --accent: #1a5cff;
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans KR',
          sans-serif;
        color: var(--fg);
        background: var(--bg);
        line-height: 1.6;
      }
      section {
        scroll-margin-top: 4.5rem;
        margin: 3rem 0;
      }
      hr {
        border: none;
        border-top: 1px solid #eee;
        margin: 2rem 0;
      }
      .jump-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 1.25rem 0;
      }
      .jump-nav a {
        padding: 0.35rem 0.8rem;
        border: 1px solid #ddd;
        border-radius: 999px;
        color: var(--fg);
        text-decoration: none;
        font-size: 0.85rem;
      }
      .jump-nav a:hover {
        border-color: var(--accent);
        color: var(--accent);
      }
      /* 간단=짧은 라벨, 자세히=산문. 섹션/표는 항상 노출 */
      body.mode-simple .detail-only {
        display: none !important;
      }
      body.mode-detail .simple-only {
        display: none !important;
      }
      .scan-list {
        margin: 0.75rem 0 0;
        padding-left: 1.2rem;
        color: var(--fg);
        font-size: 0.95rem;
      }
      .scan-list li {
        margin: 0.25rem 0;
      }
      .meta-line {
        color: var(--muted);
        font-size: 0.88rem;
        margin: 0.35rem 0 0.75rem;
      }
      .view-toggle-wrap {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 1rem 0 0.25rem;
        flex-wrap: wrap;
      }
      .view-toggle {
        appearance: none;
        border: 1px solid var(--accent);
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-size: 0.95rem;
        font-weight: 600;
        padding: 0.55rem 1.1rem;
        border-radius: 8px;
        cursor: pointer;
      }
      .view-toggle:hover {
        filter: brightness(1.05);
      }
      .view-toggle-hint {
        color: var(--muted);
        font-size: 0.85rem;
      }
      .history-table td {
        vertical-align: middle;
      }
      .bar-cell {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 140px;
      }
      .bar {
        display: block;
        height: 10px;
        border-radius: 4px;
        min-width: 2px;
      }
      .bar-pos {
        background: #34a853;
      }
      .bar-neg {
        background: #d93025;
      }
      .bar-label {
        font-size: 0.8rem;
        color: var(--muted);
        white-space: nowrap;
      }
      .container {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }
      .site-header {
        border-bottom: 1px solid #eee;
        padding: 1rem 0;
      }
      .site-header nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      .brand {
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--fg);
        text-decoration: none;
      }
      .links {
        display: flex;
        gap: 1rem;
      }
      .links a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.95rem;
      }
      .links a:hover {
        color: var(--accent);
      }
      main {
        padding: 2.5rem 1.25rem 4rem;
        min-height: 60vh;
      }
      .site-footer {
        border-top: 1px solid #eee;
        padding: 1.5rem 0;
        color: var(--muted);
        font-size: 0.8rem;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin: 1rem 0;
        font-size: 0.9rem;
      }
      th,
      td {
        text-align: left;
        padding: 0.5rem 0.6rem;
        border-bottom: 1px solid #eee;
      }
      th {
        color: var(--muted);
        font-weight: 600;
      }
      .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
        margin: 1.5rem 0;
      }
      .stat-card {
        border: 1px solid #eee;
        border-radius: 10px;
        padding: 1rem;
      }
      .stat-card .label {
        color: var(--muted);
        font-size: 0.8rem;
      }
      .stat-card .value {
        font-size: 1.4rem;
        font-weight: 700;
        margin-top: 0.25rem;
      }
      .badge {
        display: inline-block;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
      }
      .badge.positive {
        background: #e6f4ea;
        color: #1e7e34;
      }
      .badge.negative {
        background: #fde8e8;
        color: #b02a2a;
      }
      .badge.neutral {
        background: #eee;
        color: #555;
      }
    </style>
  </body>
</html>
