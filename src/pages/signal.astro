---
import BaseLayout from '../layouts/BaseLayout.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { getLatestSignal, getSignalHistory, type MonthlySignal } from '../lib/supabase';

// 데이터는 월 1회 정도만 바뀌므로, CDN에서 1시간 정도 캐시해서
// 매 요청마다 DB를 두드리지 않게 한다 (정적 사이트에 가까운 비용/속도).
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const ASSET_LABELS: Record<string, string> = {
  kospi: '코스피200 ETF',
  bond: '국채3년물 ETF',
  cash: '현금',
};

function pct(v: number): string {
  return `${(v * 100).toFixed(1)}%`;
}

function badgeClass(v: number): string {
  if (v > 0) return 'positive';
  if (v < 0) return 'negative';
  return 'neutral';
}

const latest: MonthlySignal | null = await getLatestSignal();
const history: MonthlySignal[] = await getSignalHistory(12);
---

<BaseLayout
  title="이번 달 신호"
  description="코스피200과 국채3년물의 최근 12개월 수익률을 비교한 최신 듀얼 모멘텀 신호."
>
  <p><a href="/">← 홈으로</a></p>
  <h1>이번 달 신호</h1>

  {
    !latest && (
      <p style="color:var(--muted)">
        아직 표시할 신호 데이터가 없습니다. (DB 연결 또는 최초 데이터
        입력 전일 수 있습니다.)
      </p>
    )
  }

  {
    latest && (
      <>
        <p style="color:var(--muted)">
          기준일: {latest.signal_date} · 12개월 수익률 비교 기준
        </p>

        <div class="stat-grid">
          <div class="stat-card">
            <div class="label">코스피200 12개월 수익률</div>
            <div class="value">
              <span class={`badge ${badgeClass(latest.kospi_return_12m)}`}>
                {pct(latest.kospi_return_12m)}
              </span>
            </div>
          </div>
          <div class="stat-card">
            <div class="label">국채3년물 12개월 수익률</div>
            <div class="value">
              <span class={`badge ${badgeClass(latest.bond_return_12m)}`}>
                {pct(latest.bond_return_12m)}
              </span>
            </div>
          </div>
          <div class="stat-card">
            <div class="label">선택된 자산</div>
            <div class="value">{ASSET_LABELS[latest.selected_asset]}</div>
          </div>
        </div>

        <p>
          규칙: 두 자산 중 12개월 수익률이 더 높은 쪽을 선택하되, 그
          수익률 자체가 마이너스면 현금을 보유합니다. 신호는 매달
          한 번만 바뀝니다 — 매일 확인할 필요는 없습니다.
        </p>
      </>
    )
  }

  {
    history.length > 1 && (
      <>
        <h2>최근 신호 히스토리</h2>
        <table>
          <thead>
            <tr>
              <th>기준일</th>
              <th>코스피200</th>
              <th>국채3년물</th>
              <th>선택 자산</th>
            </tr>
          </thead>
          <tbody>
            {history.map((row) => (
              <tr>
                <td>{row.signal_date}</td>
                <td>{pct(row.kospi_return_12m)}</td>
                <td>{pct(row.bond_return_12m)}</td>
                <td>{ASSET_LABELS[row.selected_asset]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }

  <Disclaimer />
</BaseLayout>
