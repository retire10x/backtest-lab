---
import BaseLayout from '../layouts/BaseLayout.astro';
import Disclaimer from '../components/Disclaimer.astro';
import {
  getLatestSignal,
  getSignalHistory,
  getLatestBacktestSummary,
  getWalkForwardResults,
  type MonthlySignal,
  type BacktestSummary,
  type WalkForwardResult,
} from '../lib/supabase';

// 데이터는 월 1회 정도만 바뀌므로 CDN에서 캐시해서 매 요청마다 DB를
// 두드리지 않게 한다 (정적 사이트에 가까운 비용/속도).
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const ASSET_LABELS: Record<string, string> = {
  kospi: '코스피200',
  bond: '국채3년물',
  cash: '현금',
};

function pct(v: number | null | undefined): string {
  if (v === null || v === undefined) return '—';
  return `${(v * 100).toFixed(1)}%`;
}

function badgeClass(v: number): string {
  if (v > 0) return 'positive';
  if (v < 0) return 'negative';
  return 'neutral';
}

const latest: MonthlySignal | null = await getLatestSignal();
const history: MonthlySignal[] = await getSignalHistory(12); // 최근 12개월치 월말 신호
const summary: BacktestSummary | null = await getLatestBacktestSummary();
const wf: WalkForwardResult[] = await getWalkForwardResults();

// 히스토리 막대 시각화용 스케일 — 보이는 12개월 중 절댓값 최대치를 100%로.
const maxAbsReturn = Math.max(
  0.01,
  ...history.flatMap((r) => [Math.abs(r.kospi_return_12m), Math.abs(r.bond_return_12m)]),
);
function barWidth(v: number): string {
  return `${Math.min(100, (Math.abs(v) / maxAbsReturn) * 100).toFixed(0)}%`;
}
---

<BaseLayout
  title="이번 달엔 뭘 살까? — 코스피200 vs 국채3년물"
  description="코스피200(주식)과 국채3년물(채권) 중 최근 1년간 더 잘 나간 쪽을 매달 알려드리는 무료 참고용 사이트. 실제 백테스트 성과도 숨김없이 공개합니다."
>
  <h1>이번 달엔 뭘 살까? — 코스피200 vs 국채3년물</h1>
  <div class="view-toggle-wrap">
    <button type="button" id="view-toggle" class="view-toggle" aria-pressed="false">
      자세히 보기
    </button>
    <span class="view-toggle-hint" id="view-toggle-hint">지금: 간단 보기</span>
  </div>
  <p>
    이 사이트가 하는 일은 딱 하나예요. <strong>코스피200</strong>(한국
    대표 주식 200개를 묶어놓은 상품)과 <strong>국채3년물</strong>(나라가
    보증하는 안전한 채권을 묶어놓은 상품) 중에서, 최근 1년간 어느 쪽
    성적이 더 좋았는지 매달 비교해서 알려드립니다. 둘 다 성적이
    나쁘면 "그냥 현금 들고 있으세요"라고 알려드려요. 무료이고
    참고용이며, 실제로 사고파는 건 여러분이 직접 본인 계좌에서
    판단해서 해야 합니다.
  </p>
  <p class="detail-only" style="color:var(--muted);font-size:0.92rem;">
    <strong>왜 이렇게 할까요?</strong> "최근에 잘 나가던 게 당분간은
    계속 잘 나갈 가능성이 조금 더 높다"는 관찰(투자 용어로는
    "모멘텀")에 기대는 방법이에요. 그래서 매달 말에 최근 1년 성적을
    다시 재고, 더 잘한 쪽으로 갈아탑니다. 어렵게 들리지만 결국
    "최근 1등한 애를 따라간다" 정도로 이해하시면 됩니다.
  </p>

  <nav class="jump-nav detail-only">
    <a href="#signal">이번 달엔 뭘?</a>
    <a href="#history">최근 1년 흐름</a>
    <a href="#backtest">그동안 성적은?</a>
    <a href="#strategy">계산 방법 · 한계</a>
  </nav>

  <hr />

  <section id="signal">
    <h2>이번 달엔 뭘 사면 될까요?</h2>

    {
      !latest && (
        <p style="color:var(--muted)">
          아직 표시할 데이터가 없습니다. (준비 중이에요.)
        </p>
      )
    }

    {
      latest && (
        <>
          <p style="color:var(--muted)">
            기준일: {latest.signal_date} · 오늘 기준으로 "지난 1년간
            얼마나 올랐는지"를 비교했어요.
          </p>
          <div class="stat-grid">
            <div class="stat-card">
              <div class="label">코스피200, 최근 1년</div>
              <div class="value">
                <span class={`badge ${badgeClass(latest.kospi_return_12m)}`}>
                  {pct(latest.kospi_return_12m)}
                </span>
              </div>
            </div>
            <div class="stat-card">
              <div class="label">국채3년물, 최근 1년</div>
              <div class="value">
                <span class={`badge ${badgeClass(latest.bond_return_12m)}`}>
                  {pct(latest.bond_return_12m)}
                </span>
              </div>
            </div>
            <div class="stat-card">
              <div class="label">이번 달 선택</div>
              <div class="value">{ASSET_LABELS[latest.selected_asset]}</div>
            </div>
          </div>
          <p style="color:var(--muted);font-size:0.88rem;">
            숫자 읽는 법: +{pct(Math.abs(latest.kospi_return_12m))}는 "1년
            전보다 그만큼 올랐다", 마이너스면 "그만큼 내렸다"는 뜻이에요.
            신호는 한 달에 한 번만 바뀌니, 매일 들여다볼 필요는
            없습니다.
          </p>
        </>
      )
    }
  </section>

  <section id="history" class="detail-only">
    <h2>최근 1년 동안 어떻게 바뀌어 왔나요?</h2>
    <p style="color:var(--muted);font-size:0.9rem;">
      매달 말마다 "그 시점 기준 최근 1년 성적"을 다시 계산해요. 아래는
      최근 12번(약 1년치) 계산 결과예요. 막대가 길수록 많이 오르거나
      내렸다는 뜻이고, 초록은 플러스, 빨강은 마이너스입니다.
    </p>
    <p style="color:var(--muted);font-size:0.85rem;background:#f6f6f6;padding:0.6rem 0.8rem;border-radius:8px;">
      숫자가 유난히 커 보이나요? 오류가 아니에요. 2026년 코스피가
      사상 처음 8,000선을 넘었다가 크게 출렁인 특수한 시기라, 코스피200
      수익률이 이례적으로 높게 나옵니다. 이런 시기가 항상 반복되는
      건 아니라는 점을 감안해서 보세요.
    </p>

    {
      history.length === 0 && (
        <p style="color:var(--muted)">아직 데이터가 없습니다.</p>
      )
    }

    {
      history.length > 0 && (
        <table class="history-table">
          <thead>
            <tr>
              <th>기준월</th>
              <th>코스피200</th>
              <th>국채3년물</th>
              <th>그때 선택</th>
            </tr>
          </thead>
          <tbody>
            {history.map((row) => (
              <tr>
                <td>{row.signal_date}</td>
                <td>
                  <div class="bar-cell">
                    <span
                      class={`bar ${row.kospi_return_12m >= 0 ? 'bar-pos' : 'bar-neg'}`}
                      style={`width:${barWidth(row.kospi_return_12m)}`}
                    />
                    <span class="bar-label">{pct(row.kospi_return_12m)}</span>
                  </div>
                </td>
                <td>
                  <div class="bar-cell">
                    <span
                      class={`bar ${row.bond_return_12m >= 0 ? 'bar-pos' : 'bar-neg'}`}
                      style={`width:${barWidth(row.bond_return_12m)}`}
                    />
                    <span class="bar-label">{pct(row.bond_return_12m)}</span>
                  </div>
                </td>
                <td>{ASSET_LABELS[row.selected_asset]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </section>

  <section id="backtest">
    <h2>그래서 이 방법, 진짜 돈이 됐을까요?</h2>
    <p style="color:var(--muted);font-size:0.9rem;">
      "만약 몇 년 전부터 이 방법대로 계속 했다면 어땠을까"를 실제
      과거 가격으로 계산해본 결과예요. 과장 없이 있는 그대로
      보여드립니다.
    </p>

    {
      !summary && (
        <p style="color:var(--muted)">아직 표시할 데이터가 없습니다.</p>
      )
    }

    {
      summary && (
        <>
          <p style="color:var(--muted)">
            계산 기간: {summary.period_start} ~ {summary.period_end}
          </p>
          <div class="stat-grid">
            <div class="stat-card">
              <div class="label">1년에 평균 몇 % 벌었나</div>
              <div class="value">
                <span class={`badge ${badgeClass(summary.cagr)}`}>{pct(summary.cagr)}</span>
              </div>
            </div>
            <div class="stat-card">
              <div class="label">가장 크게 떨어졌을 때</div>
              <div class="value"><span class="badge negative">{pct(summary.mdd)}</span></div>
            </div>
            <div class="stat-card">
              <div class="label">처음부터 지금까지 총 수익</div>
              <div class="value">
                <span class={`badge ${badgeClass(summary.total_return)}`}>
                  {pct(summary.total_return)}
                </span>
              </div>
            </div>
          </div>

          <p style="color:var(--muted);font-size:0.88rem;">
            "가장 크게 떨어졌을 때"는 이 방법을 썼어도 한때 계좌가
            얼마나 쪼그라들 수 있었는지를 보여줘요. 마음의 준비용으로
            꼭 같이 봐야 하는 숫자입니다.
          </p>

          <div class="detail-only">
            <h3>다른 선택지와 비교하면?</h3>
            <table>
              <thead>
                <tr><th>방법</th><th>1년 평균 수익률</th><th>가장 크게 떨어졌을 때</th></tr>
              </thead>
              <tbody>
                <tr>
                  <td>이 방법(코스피200 ↔ 국채3년물)</td>
                  <td>{pct(summary.cagr)}</td>
                  <td>{pct(summary.mdd)}</td>
                </tr>
                <tr>
                  <td>그냥 아무 주식이나 사서 계속 들고만 있었다면</td>
                  <td>{pct(summary.passive_benchmark_cagr)}</td>
                  <td>{pct(summary.passive_benchmark_mdd)}</td>
                </tr>
                <tr>
                  <td>그냥 은행 정기예금에 넣어뒀다면</td>
                  <td>{pct(summary.savings_bank_rate)}</td>
                  <td>0.0%</td>
                </tr>
              </tbody>
            </table>

            {summary.verdict_note && (
              <p><strong>쉽게 말하면:</strong> {summary.verdict_note}</p>
            )}
          </div>
        </>
      )
    }

    {
      wf.length > 0 && (
        <div class="detail-only">
          <h3>해마다 다시 시작했다면?</h3>
          <p style="color:var(--muted);font-size:0.9rem;">
            매년 1월 1일에 처음부터 다시 시작했다고 가정하고, 그 해
            한 해 성적만 따로 계산했어요. 은행 예금(연 4%)보다
            나았는지도 같이 표시했습니다. 못 넘긴 해도 숨기지 않고
            그대로 보여드려요.
          </p>
          <table>
            <thead>
              <tr><th>연도</th><th>그 해 수익률</th><th>가장 크게 떨어졌을 때</th><th>은행보다 나았나</th><th>비고</th></tr>
            </thead>
            <tbody>
              {wf.map((row) => (
                <tr>
                  <td>{row.year}</td>
                  <td>
                    <span class={`badge ${badgeClass(row.annual_return)}`}>
                      {pct(row.annual_return)}
                    </span>
                  </td>
                  <td>{pct(row.mdd)}</td>
                  <td>{row.beats_savings_bank ? '예' : '아니오'}</td>
                  <td style="color:var(--muted);">{row.note || ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <section id="strategy" class="detail-only">
    <h2>어떻게 계산하나요? 조심해야 할 점은?</h2>
    <p style="color:var(--muted);font-size:0.9rem;">
      복잡한 조정 없이, 아래 4가지 규칙만 그대로 반복해요. 상황 봐가며
      규칙을 바꾸지 않습니다 — 그래야 결과를 믿을 수 있으니까요.
    </p>
    <ol>
      <li>매달 마지막 날, 두 자산이 각각 최근 1년간 얼마나 올랐는지 잰다.</li>
      <li>더 많이 오른 쪽을 다음 한 달간 사면 좋은 자산으로 정한다.</li>
      <li>둘 다 마이너스면(둘 다 안 좋으면) 그냥 현금을 들고 있으라고 알려준다.</li>
      <li>이 판단은 한 달에 딱 한 번만 한다 — 하루하루 흔들리지 않는다.</li>
    </ol>
    <p style="color:var(--muted);font-size:0.9rem;background:#f6f6f6;padding:0.6rem 0.8rem;border-radius:8px;">
      <strong>Q. 고점에서 확 떨어지면 바로 현금으로 안 바꾸나요?</strong><br />
      안 바꿉니다. 이 규칙은 "요즘 얼마나 떨어졌나"가 아니라
      "정확히 1년 전 가격과 비교해서 여전히 이기고 있나"만 봐요. 최근
      고점 대비 크게 빠졌어도, 1년 전 가격 자체가 지금보다 훨씬
      낮았다면 여전히 "1년 전보다 높다"로 계산돼서 계속 들고
      있으라고 나올 수 있어요. 하락 초입엔 반응이 느리다는 뜻이고,
      이건 이 방법의 실제 한계입니다.
    </p>
    <p>
      <strong>이 방법의 한계.</strong> 최근 몇 년 상승장에서 성적이
      특히 좋았던 편이라, 앞으로도 똑같이 잘될 거라는 보장은 없어요.
      위 "해마다 다시 시작했다면?" 표를 보면 은행 예금보다 못한 해도
      여러 번 있었습니다. 주식·채권이 뚜렷한 방향 없이 오르락내리락만
      할 때는 뒤늦게 사고 뒤늦게 파는 손해가 날 수도 있고요. 검증한
      기간도 10년 정도라, 2008년 금융위기 같은 아주 큰 충격은 겪어보지
      못했어요. 참고로 예전에 다른 방법(개별 종목 단타 성격의 전략들)도
      시도해봤는데, 그건 은행 예금만도 못해서 접었습니다 — 안 되는
      것도 숨기지 않고 알려드립니다.
    </p>
  </section>

  <Disclaimer />

  <script>
    const STORAGE_KEY = 'bl-view-mode';
    const btn = document.getElementById('view-toggle');
    const hint = document.getElementById('view-toggle-hint');

    function isDetail() {
      return document.body.classList.contains('mode-detail');
    }

    function applyMode(detail: boolean) {
      document.body.classList.toggle('mode-detail', detail);
      document.body.classList.toggle('mode-simple', !detail);
      if (btn) {
        btn.textContent = detail ? '간단히 보기' : '자세히 보기';
        btn.setAttribute('aria-pressed', detail ? 'true' : 'false');
      }
      if (hint) {
        hint.textContent = detail ? '지금: 자세히 보기' : '지금: 간단 보기';
      }
      try {
        localStorage.setItem(STORAGE_KEY, detail ? 'detail' : 'simple');
      } catch (_) {}
    }

    // 인라인 스크립트가 복원한 상태와 버튼 라벨을 맞춤
    applyMode(isDetail());

    btn?.addEventListener('click', () => {
      applyMode(!isDetail());
    });
  </script>
</BaseLayout>
